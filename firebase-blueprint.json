{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents the progress and settings profile for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique user ID from Firebase Authentication."
        },
        "email": {
          "type": "string",
          "description": "The user's registered Google email address."
        },
        "completedLessons": {
          "type": "array",
          "description": "List of completed lesson IDs."
        },
        "completedQuizzes": {
          "type": "object",
          "description": "Mapping of quiz topics to progress scores."
        },
        "savedPlaygroundCode": {
          "type": "string",
          "description": "Active playground code stored by the developer."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when progress was last synchronized."
        }
      },
      "required": ["uid", "email"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A custom dynamic lesson provided by an administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "description": { "type": "string" },
        "estimate": { "type": "string" },
        "explanation": { "type": "string" },
        "syntax": { "type": "string" },
        "code": { "type": "string" },
        "outputExplanation": { "type": "string" },
        "practiceTask": { "type": "string" },
        "commonMistakes": { "type": "string" },
        "interviewQuestion": { "type": "string" },
        "miniQuiz": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "level", "description", "explanation"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "A custom dynamic quiz question provided by an administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "answerIndex": { "type": "integer" },
        "explanation": { "type": "string" },
        "topic": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "question", "options", "answerIndex", "explanation", "topic"]
    },
    "Snippet": {
      "title": "Snippet",
      "description": "A custom dynamic code snippet provided by an administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "code": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "difficulty", "description", "category", "code"]
    },
    "Project": {
      "title": "Project",
      "description": "A custom dynamic project challenge provided by an administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "requiredConcepts": { "type": "array" },
        "starterCode": { "type": "string" },
        "finalChallenge": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "level", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "The custom user document mapping to individual developer profiles."
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Admin created dynamic lessons overrides and inclusions."
    },
    "/quizzes/{quizId}": {
      "schema": "QuizQuestion",
      "description": "Admin created dynamic quiz questions."
    },
    "/snippets/{snippetId}": {
      "schema": "Snippet",
      "description": "Admin created dynamic UI snippets."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Admin created dynamic coding projects."
    }
  }
}
